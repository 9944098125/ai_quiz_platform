{
  "name": "ai-quiz-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter frontend --filter backend run dev",
    "start": "pnpm run dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "build:frontend": "pnpm --filter frontend run build",
    "lint:frontend": "pnpm --filter frontend run lint",
    "typecheck:frontend": "pnpm --filter frontend run typecheck",
    "test:frontend": "pnpm --filter frontend run test",
    "dev:backend": "pnpm --filter backend run dev",
    "build:backend": "pnpm --filter backend run build",
    "lint:backend": "pnpm --filter backend run lint",
    "typecheck:backend": "pnpm --filter backend run typecheck",
    "test:backend": "pnpm --filter backend run test",
    "start:backend": "pnpm --filter backend run start",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "typecheck": "pnpm typecheck:frontend && pnpm typecheck:backend",
    "build": "pnpm build:frontend && pnpm build:backend",
    "test": "pnpm test:frontend && pnpm test:backend",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
